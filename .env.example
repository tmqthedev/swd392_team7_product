# AIVES environment variables.
#
# Copy to `.env` for local development (the committed defaults below match the
# docker-compose stack). The "prod" note on each line explains how the value is
# supplied in production. Behavior never branches on an "is local" flag — only
# the values below differ between environments.
#
# Secrets (JWT_SECRET, the Postgres password inside DATABASE_URL, the Gmail App
# Password behind SMTP_USER, and any Google TTS key) must live only in `.env`
# locally and be sourced from SSM Parameter Store / Secrets Manager in prod.
# Never commit real secret values.

# --- Core server ---
# Port the Node backend listens on. Prod: fixed by the task definition.
PORT=3000
# AWS region for SDK clients. Prod: real deployment region.
AWS_REGION=ap-southeast-1
# Use in-memory AWS adapters instead of real AWS calls.
# Prod: false (real DynamoDB/S3/Lambda/Bedrock).
AWS_MOCK_MODE=true
# Use the in-memory JSON database instead of Postgres.
# Prod: false (RDS Postgres). docker-compose sets this to false.
DB_MOCK_MODE=true

# --- Database ---
# Postgres connection string; migrations auto-run at startup when DB_MOCK_MODE=false.
# Prod: points at RDS; password sourced from SSM/Secrets Manager, not committed.
DATABASE_URL=postgres://aives:aives@localhost:5432/aives

# --- AWS service endpoints (local emulators) ---
# Local DynamoDB endpoint. Prod: unset (SDK uses the real regional endpoint).
DYNAMODB_ENDPOINT=http://localhost:8000
# Local S3 (MinIO) endpoint. Prod: unset (real S3).
S3_ENDPOINT=http://localhost:9000
# Local STT/Lambda RIE endpoint. Prod: unset (real Lambda invoke).
LAMBDA_ENDPOINT=http://localhost:8080

# --- Buckets ---
# Bucket for uploaded course materials. Prod: real S3 bucket name.
MATERIALS_BUCKET_NAME=local-materials-bucket
# Bucket for interview audio. Prod: real S3 bucket name.
AUDIO_BUCKET_NAME=local-audio-bucket

# --- Email (SMTP) ---
# SMTP host. Local: Mailpit. Prod: smtp.gmail.com (or chosen provider).
SMTP_HOST=localhost
# SMTP port. Local: Mailpit 1025. Prod: 587.
SMTP_PORT=1025
# SMTP user / Gmail App Password holder. Local: blank (Mailpit needs no auth).
# Prod: the sender account; the App Password is a secret (SSM/Secrets Manager).
SMTP_USER=
# SMTP password / Gmail App Password. Local: blank (Mailpit needs no auth).
# Prod: secret (SSM/Secrets Manager). Only used when SMTP_USER is set.
# SMTP_PASS=
# Public base URL used in generated links (e.g. password emails).
# Prod: the real site URL.
APP_BASE_URL=http://localhost:8080

# --- Bedrock models ---
# Chat/generation model id. Prod: the approved model id for the account/region.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# Embedding model id (1024-dim vectors). Prod: the approved embedding model id.
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Auth ---
# Secret used to sign JWTs. SECRET: .env only locally, SSM/Secrets Manager in prod.
JWT_SECRET=change-me-in-local-only
# Access token lifetime in seconds (short-lived, stateless). Default 900 (15 min).
# JWT_ACCESS_TTL_SEC=900
# Refresh token lifetime in seconds. Default 604800 (7 days).
# JWT_REFRESH_TTL_SEC=604800
# Set the Secure flag on auth cookies. Local: false (plain http). Prod: true (https only).
# COOKIE_SECURE=false
# SameSite policy for auth cookies. Default Lax.
# COOKIE_SAME_SITE=Lax
# From address for outgoing mail. Prod: the verified sender address.
# SMTP_FROM=no-reply@aives.local
# Use a TLS socket for SMTP. Local: false (Mailpit). Prod: true for port 465.
# SMTP_SECURE=false
# Hours a set-password link stays valid. Default 72.
# PASSWORD_SET_TTL_HOURS=72
# Minutes a reset-password link stays valid. Default 30.
# PASSWORD_RESET_TTL_MINUTES=30
# Failed logins within the window before the account is locked. Default 5.
# LOGIN_MAX_FAILURES=5
# Rolling window (minutes) over which failed logins are counted. Default 15.
# LOGIN_WINDOW_MINUTES=15
# Lockout duration (minutes) once the failure threshold is hit. Default 15.
# LOGIN_LOCK_MINUTES=15

# --- Background job queue ---
# Max jobs processed concurrently by the worker loop.
JOB_QUEUE_CONCURRENCY=2
# Poll interval (ms) for the worker loop; also the retry backoff base.
JOB_QUEUE_POLL_INTERVAL_MS=1000
# Max attempts before a job is left FAILED.
JOB_MAX_ATTEMPTS=3
# A job left RUNNING longer than this (ms) is assumed orphaned by a crashed or
# restarted worker and is re-queued (or FAILED once attempts are exhausted).
# JOB_LOCK_TIMEOUT_MS=600000

# --- Migrations ---
# Directory holding numbered *.sql migrations. Default resolves to backend/db/migrations.
# MIGRATIONS_DIR=backend/db/migrations

# --- Speech providers ---
# Speech-to-text provider: mock | lambda (PhoWhisper via LAMBDA_ENDPOINT, Step 9).
# AWS_MOCK_MODE=true always forces the mock. Prod: lambda.
STT_PROVIDER=mock
# Text-to-speech provider: mock | google (Step 9). AWS_MOCK_MODE=true always
# forces the mock. Prod: google (API key is a secret, SSM/Secrets Manager).
TTS_PROVIDER=mock

# --- DynamoDB session table ---
# Table holding viva session context (interview items keyed "interview#<id>",
# TTL attribute expiresAt). Prod: real DynamoDB table name.
SESSION_TABLE_NAME=viva-session-context
# Create the session table (and enable TTL) at startup when it is missing.
# Local: true (DynamoDB Local starts empty). Prod: false (Terraform owns the table).
SESSION_TABLE_AUTO_CREATE=true
# Seconds an interview context item outlives its deadline before TTL deletes it.
# Default 86400 (1 day).
# SESSION_CONTEXT_TTL_GRACE_SEC=86400

# --- Interview engine ---
# Per-attempt timeout (ms) for the follow-up LLM call; a timeout counts as a
# failed attempt (retry once, then move to the next main question). Default 15000.
# FOLLOW_UP_LLM_TIMEOUT_MS=15000
